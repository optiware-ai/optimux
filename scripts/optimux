#!/usr/bin/env bash
# shellcheck disable=SC2034
# The optimux command: start, stop, update and manage an installed Optimux.
# It uses the installer's own functions (install.sh), so both behave the same.
set -Eeuo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OPTIMUX_LIB_ONLY=1 source "$HERE/../install.sh"

help() {
  local ROW_W=24
  heading "optimux <command>"
  subhead "Run"
  row "start | stop | restart" "run Optimux, or stop it"
  row "status" "is it running, where, which version"
  row "logs" "follow the server's log (Ctrl+C to leave)"
  subhead "Reach it"
  row "open" "the address, or the SSH tunnel command   ${CM}(open --help)${C0}"
  row "port" "the ports in use; move Optimux   ${CM}(port --help)${C0}"
  subhead "Manage"
  row "update" "download the latest version and restart"
  row "version" "the installed version"
  row "password" "choose a new sign-in password"
  row "reset-password" "forget the password and two-step codes"
  row "token" "the access token (first sign-in, scripts)"
  row "github" "install the GitHub CLI and add a GitHub token"
  row "uninstall" "remove Optimux (asks before deleting data)"
  printf '\n'
  para "Everything else is in the web interface: Dashboard → Guide."
  printf '\n'
}

main_cli() {
  export PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin"
  tui_init
  trap on_exit EXIT
  detect_system
  CM_YES=""
  find_install || die "Optimux isn't installed here (no install.env found). Install it with install.sh."
  # Server installs are managed with sudo; a local install never needs it
  if [[ "${M[MODE]}" == server && $EUID -ne 0 ]]; then CM_SUDO="sudo"; else CM_SUDO=""; fi
  case "${1:-help}" in
    start) cli_start; ok "Started: ${M[URL]}" ;;
    stop) cli_stop ;;
    restart) cli_restart ;;
    status) cli_status ;;
    logs) cli_logs ;;
    open|url|tunnel|browser) shift; cli_open "$@" ;;
    port) shift; cli_port "$@" ;;
    update) cli_update ;;
    password) cli_password ;;
    reset-password) admin reset-password ;;
    token) cli_token ;;
    github) cli_github ;;
    uninstall) cli_uninstall ;;
    version) app_version "${M[APP_DIR]}" ;;
    help|-h|--help) help ;;
    *) err "Unknown command: $1"; help; exit 2 ;;
  esac
}

main_cli "$@"
