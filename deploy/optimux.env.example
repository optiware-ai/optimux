# /etc/optimux/optimux.env (owner root, mode 640, group optimux)
# Server mode: sandbox required, auto-approve off, commands without network
# (unless you turn it on in Execution), secure cookies.
OPTIMUX_SERVER=1
# Where Optimux keeps its data (keys, password hash, chats, memory)
OPTIMUX_HOME=/var/lib/optimux/.optimux
HOME=/var/lib/optimux
# The public address, if the browser's Origin differs from the Host the proxy forwards
# OPTIMUX_ALLOWED_ORIGINS=https://optimux.example.com
# Names Optimux answers for when it is reached over TCP (not needed behind Caddy on
# the socket, nor for localhost or IP addresses): a proxy to 127.0.0.1:PORT needs its domain
# OPTIMUX_ALLOWED_HOSTS=optimux.example.com
